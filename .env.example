# Copie para .env e defina senhas locais fortes antes de `docker compose up`.
# Nunca coloque credenciais reais de produção ou de provedores neste arquivo de exemplo.

# Obrigatórios (o compose falha com mensagem explícita se estiverem vazios)
DB_PASSWORD=
DEMO_DB_PASSWORD=
APP_DB_PASSWORD=
# Segredo HMAC dos webhooks do simulador Pix (valor aleatório local)
OFICINA_PIX_WEBHOOK_SEGREDO=
REDIS_PASSWORD=

# Opcionais
# Produção atrás de HTTPS: SESSION_SECURE_COOKIE=true e IPs/CIDR do proxy reverso
SESSION_SECURE_COOKIE=false
OFICINA_PROXIES_CONFIAVEIS=
APP_ENV=local
APP_DEBUG=false
APP_PORT=8092
APP_URL=http://localhost:8092
LOG_LEVEL=info
# principal | demo  (demo só exibe o banco separado de demonstração; nunca carrega dados)
OFICINA_BANCO=principal
# simulado: nenhuma integração real é contatada. Integrações reais dependem de provedor homologado.
OFICINA_INTEGRACOES=simulado
# Botão de simular pagamento Pix (somente desenvolvimento/demonstração; nunca com dados reais)
OFICINA_PERMITE_SIMULAR_PAGAMENTO=false
